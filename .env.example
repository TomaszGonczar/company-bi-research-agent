# OPTIONAL LIVE RESEARCH ONLY. Offline tests/eval/review need no environment file.
# Copy to .env, replace the placeholder locally, and load explicitly with:
# uv run --frozen --env-file .env company-bi batch examples/research_batch.csv
# .env and other credential/session files must never be committed.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
COMPANY_BI_MODEL=openai-codex:gpt-6-luna
# Native Codex uses standard `codex login` and SDK-managed authentication.
# OPENAI_API_KEY is not required for this native model; do not copy auth caches here.
